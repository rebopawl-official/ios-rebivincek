diff --git a/pexpert/arm/pe_fiq.c b/pexpert/arm/pe_fiq.c
index 6089db9..78253eb 100644
--- a/pexpert/arm/pe_fiq.c
+++ b/pexpert/arm/pe_fiq.c
@@ -14,6 +14,152 @@
 
 
 #if HAS_GIC_V3
+#if defined(VINCE)
+/*
+ * vince (Redmi 5 Plus, MSM8953): GICv2 (qcom,msm-qgic2). There are no redistributors
+ * and no ICC_* system registers: the distributor (GICD) and the per-CPU interface
+ * (GICC, banked at the same address on every core) are plain MMIO. The firmware
+ * (LK) leaves the non-secure view enabled and delivers it as IRQ (measured by the
+ * vince-m2 test image on this phone: virtual timer INTID 20 and SGI 1 arrive as IRQ,
+ * priority 0xa0, PMR 0xf0). Group assignment is TrustZone's; we only touch what
+ * the non-secure side may write.
+ */
+#define V2D_CTLR        0x000
+#define V2D_ISENABLER0  0x100
+#define V2D_IPRIORITYR  0x400
+#define V2D_ITARGETSR0  0x800
+#define V2D_SGIR        0xf00
+#define V2C_CTLR        0x000
+#define V2C_PMR         0x004
+#define V2C_IAR         0x00c
+#define V2C_EOIR        0x010
+#define V2_MAX_CPUS     8
+
+SECURITY_READ_ONLY_LATE(uint32_t) sweet_vtimer_intid = SWEET_VTIMER_INTID;
+
+static vm_offset_t gicd_base;
+static vm_offset_t gicc_base;
+/* CPU-interface bit of every logical CPU, as read back by that CPU from GICD_ITARGETSR0 */
+static uint8_t gic_cpu_target[V2_MAX_CPUS];
+
+static inline uint32_t
+v2_read32(vm_offset_t addr)
+{
+	return *(volatile uint32_t *)addr;
+}
+
+static inline void
+v2_write32(vm_offset_t addr, uint32_t value)
+{
+	*(volatile uint32_t *)addr = value;
+}
+
+/* Acknowledge: returns GICC_IAR (INTID in bits 9:0, source CPU in 12:10 for SGIs). */
+uint32_t
+sweet_gic_ack(void)
+{
+	return v2_read32(gicc_base + V2C_IAR);
+}
+
+/* End of interrupt: GICC_EOIR takes the whole value read from GICC_IAR. */
+void
+sweet_gic_eoi(uint32_t iar)
+{
+	v2_write32(gicc_base + V2C_EOIR, iar);
+}
+
+void
+sweet_gic_send_sgi(unsigned int target_cpu, unsigned int sgi)
+{
+	uint32_t mask = (target_cpu < V2_MAX_CPUS) ? gic_cpu_target[target_cpu] : 0;
+	if (mask == 0) {
+		panic("%s: no GIC CPU interface known for logical CPU %u", __func__, target_cpu);
+	}
+	__builtin_arm_dsb(DSB_SY);
+	/* TargetListFilter 0: forward to the CPU interfaces in the target list */
+	v2_write32(gicd_base + V2D_SGIR, (mask << 16) | (sgi & 0xf));
+}
+
+void
+pe_init_fiq()
+{
+	int error;
+	DTEntry entry;
+
+	// gicd_base is 0x0 only before it's initialized by the boot processor.
+	// Avoid calling SecureDT* routines on secondary processors to avoid
+	// race conditions because they are not thread-safe.
+	if (!gicd_base) {
+		error = SecureDTLookupEntry(NULL, "/arm-io/gic", &entry);
+		if (error != kSuccess) {
+			panic("%s: cannot find GIC node in DT", __func__);
+		}
+
+		void const *prop;
+		unsigned int prop_size;
+		error = SecureDTGetProperty(entry, "reg", &prop, &prop_size);
+		if (error != kSuccess) {
+			panic("%s: cannot find GIC MMIO regions in DT", __func__);
+		}
+		// GICD base, GICD size, GICC base, GICC size (all uint64_t, relative to the SoC base)
+		if (prop_size < 4 * sizeof(uint64_t)) {
+			panic("%s: incorrect reg property size in GIC DT node; expecting 32 bytes but got %u bytes", __func__, prop_size);
+		}
+
+		void const *timer_prop;
+		unsigned int timer_size;
+		if (SecureDTGetProperty(entry, "virtual-timer-intid", &timer_prop, &timer_size) == kSuccess) {
+			if (timer_size != sizeof(uint32_t)) {
+				panic("%s: invalid virtual-timer-intid size %u", __func__, timer_size);
+			}
+			uint32_t intid = *(const uint32_t *)timer_prop;
+			if (intid < 16 || intid >= 32) {
+				panic("%s: virtual timer INTID %u is not a PPI", __func__, intid);
+			}
+			sweet_vtimer_intid = intid;
+		}
+		kprintf("VINCE GIC: GICv2, virtual timer INTID %u\n", sweet_vtimer_intid);
+
+		vm_offset_t soc_base_phys = pe_arm_get_soc_base_phys();
+		uint64_t const *regs = (uint64_t const *)prop;
+
+		vm_offset_t d = ml_io_map(soc_base_phys + regs[0], regs[1]);
+		if (!d) {
+			panic("%s: cannot map GICD region", __func__);
+		}
+		vm_offset_t c = ml_io_map(soc_base_phys + regs[2], regs[3]);
+		if (!c) {
+			panic("%s: cannot map GICC region", __func__);
+		}
+		gicc_base = c;
+		gicd_base = d;
+		// LK leaves the distributor enabled; make sure (group 1, non-secure view).
+		v2_write32(gicd_base + V2D_CTLR, v2_read32(gicd_base + V2D_CTLR) | 1);
+	}
+
+	// Banked per CPU: SGI/PPI priorities and enables. Same values the vince-m2
+	// test used on this phone.
+	for (unsigned int i = 0; i < 32; i += 4) {
+		v2_write32(gicd_base + V2D_IPRIORITYR + i, 0xA0A0A0A0);
+	}
+	v2_write32(gicd_base + V2D_ISENABLER0, (1U << sweet_vtimer_intid) | (1U << SWEET_IPI_SGI));
+
+	// GICD_ITARGETSR0..7 read back the calling CPU's own interface bit.
+	unsigned int cpu = ml_get_cpu_number_local();
+	uint32_t target = v2_read32(gicd_base + V2D_ITARGETSR0) & 0xff;
+	if (target == 0) {
+		target = 1U << (cpu % V2_MAX_CPUS);
+	}
+	if (cpu < V2_MAX_CPUS) {
+		gic_cpu_target[cpu] = (uint8_t)target;
+	}
+
+	v2_write32(gicc_base + V2C_PMR, 0xF0);
+	v2_write32(gicc_base + V2C_CTLR, 1);
+	__builtin_arm_dsb(DSB_SY);
+	__builtin_arm_isb(ISB_SY);
+}
+#else /* !VINCE */
 #define GICR_WAKE_TIMEOUT_NS (1000000000ULL) // timeout for redistributor wakeup (default 1s)
 MACHINE_TIMEOUT(gicr_wake_timeout_ns, "gicr-wake-timeout", GICR_WAKE_TIMEOUT_NS, MACHINE_TIMEOUT_UNIT_NSEC, NULL);
 
@@ -222,6 +368,7 @@ pe_init_fiq()
 	__builtin_arm_isb(ISB_SY);
 #endif /* SWEET */
 }
+#endif /* VINCE */
 #else
 void
 pe_init_fiq()
