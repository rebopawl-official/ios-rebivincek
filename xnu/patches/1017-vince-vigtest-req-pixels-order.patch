From 1b3ce53e1606dd012ebdda12b21361b1e2e3dc0a Mon Sep 17 00:00:00 2001
From: x <a@b>
Date: Thu, 12 Nov 2026 09:29:49 +0000
Subject: [PATCH] 1017 vince: vincevigtest gives the pixel request height and
 width in the right halves

SW_PIX_EXT_REQ_PIXELS has the left-right count in its low half and top-bottom in its high half; the
test had them the other way round, so a 1080x2160 picture asked the pipe for 2160 pixels of
1080 lines: about half the screen, then the underflow colour. That also fits RGB1 and DMA0 (no
request at all, all blue). The step unit goes back to 1<<21 and the last scaled phase uses the
nearest filter.

Co-Authored-By: Claude Sonnet 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01UTtYRgmKyxgNh36HwFrzar
---
 iokit/Kernel/arm/SweetFramebuffer.cpp | 14 +++++++++-----
 1 file changed, 9 insertions(+), 5 deletions(-)

diff --git a/iokit/Kernel/arm/SweetFramebuffer.cpp b/iokit/Kernel/arm/SweetFramebuffer.cpp
index c995390..32a0e78 100644
--- a/iokit/Kernel/arm/SweetFramebuffer.cpp
+++ b/iokit/Kernel/arm/SweetFramebuffer.cpp
@@ -746,11 +746,10 @@ AppleCLCD::vinceVigTest(void)
 		for (i = 0; i < 4; i++) {
 			vig[(0x100 + 0x10 * i) / 4] = (ph == 0 || ph == 3) ? 0 : 0x1;                       /* SW_PIX_EXT_LR */
 			vig[(0x104 + 0x10 * i) / 4] = (ph == 0 || ph == 3) ? 0 : 0x1;                       /* SW_PIX_EXT_TB */
-			vig[(0x108 + 0x10 * i) / 4] = (ph == 0 || ph == 3) ? ((sw << 16) | sh) : (((sw + 1) << 16) | (sh + 1));   /* REQ_PIXELS */
+			vig[(0x108 + 0x10 * i) / 4] = (ph == 0 || ph == 3) ? ((sh << 16) | sw) : (((sh + 1) << 16) | (sw + 1));   /* REQ_PIXELS: TOP_BOTTOM above LEFT_RIGHT */
 		}
-		/* the first scaled phase uses 1.0 = 1 << 21 (the Linux driver); the last 1.0 = 1 << 20, because the bands came out
-		 * about twice as thin as they should, as if the hardware counted in 1 << 20 */
-		uint32_t unit = ph == 2 ? 20 : 21;
+		/* 1.0 = 1 << 21, as the Linux driver has it */
+		uint32_t unit = 21;
 
 		vig[0x210 / 4] = (ph == 0 || ph == 3) ? 0x200000 : (uint32_t)(((uint64_t)1 << unit) * W / 1080);   /* SCALE_PHASE_STEP_X */
 		vig[0x214 / 4] = (ph == 0 || ph == 3) ? 0x200000 : (uint32_t)(((uint64_t)1 << unit) * H / 2160);   /* SCALE_PHASE_STEP_Y */
@@ -759,7 +758,7 @@ AppleCLCD::vinceVigTest(void)
 		if (ph == 0 || ph == 3) {
 			vig[0x204 / 4] = 0;                       /* SCALE_CONFIG: off */
 		} else {
-			uint32_t f = 2;                               /* the downscale filter */
+			uint32_t f = ph == 1 ? 2 : 0;             /* the downscale filter, then nearest */
 
 			vig[0x204 / 4] = 0x3 | (f << 8) | (f << 12) | (f << 16) | (f << 20);
 		}
@@ -803,6 +802,11 @@ AppleCLCD::vinceVigTest(void)
 			pp[0x30 / 4] = 0x0002243f;
 			pp[0x34 / 4] = 0x00020001;
 			pp[0x38 / 4] = 0x80000000;
+			for (i = 0; i < 4; i++) {
+				pp[(0x100 + 0x10 * i) / 4] = 0;
+				pp[(0x104 + 0x10 * i) / 4] = 0;
+				pp[(0x108 + 0x10 * i) / 4] = (2160u << 16) | 1080u;   /* the pixels it must fetch */
+			}
 			__asm__ volatile ("dsb sy" ::: "memory");
 			ctl[0] = pipes[k].layer;
 			__asm__ volatile ("dsb sy" ::: "memory");
