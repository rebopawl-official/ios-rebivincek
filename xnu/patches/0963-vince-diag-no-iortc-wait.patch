+/* Registers that decide whether the virtual timer interrupt can reach this CPU (read only). */
+void
+vince_gic_dump(void)
+{
+	if (!gicd_base || !gicc_base) {
+		printf("VDIAG GIC not mapped\n");
+		return;
+	}
+	unsigned int v = sweet_vtimer_intid;
+	printf("VDIAG GICD ctlr=%x grp0=%x isen0=%x pend0=%x act0=%x pri=%x\n",
+	    v2_read32(gicd_base + V2D_CTLR), v2_read32(gicd_base + 0x080), v2_read32(gicd_base + V2D_ISENABLER0),
+	    v2_read32(gicd_base + 0x200), v2_read32(gicd_base + 0x300),
+	    v2_read32(gicd_base + V2D_IPRIORITYR + (v & ~3U)));
+	printf("VDIAG GICC ctlr=%x pmr=%x bpr=%x rpr=%x hppir=%x vtimer=%u\n",
+	    v2_read32(gicc_base + V2C_CTLR), v2_read32(gicc_base + V2C_PMR), v2_read32(gicc_base + 0x08),
+	    v2_read32(gicc_base + 0x14), v2_read32(gicc_base + 0x18), v);
+}
 #else /* !VINCE */
 #define GICR_WAKE_TIMEOUT_NS (1000000000ULL) // timeout for redistributor wakeup (default 1s)
 MACHINE_TIMEOUT(gicr_wake_timeout_ns, "gicr-wake-timeout", GICR_WAKE_TIMEOUT_NS, MACHINE_TIMEOUT_UNIT_NSEC, NULL);
