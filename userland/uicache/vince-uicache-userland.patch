From 7a65500b5820310afcc18c7bbcac36faf1d4a0c7 Mon Sep 17 00:00:00 2001
From: claude <noreply@anthropic.com>
Date: Sat, 14 Nov 2026 11:43:07 +0000
Subject: [PATCH] Add vince-uicache

---
 .github/workflows/uicache.yml       | 27 ++++++++++
 userland/uicache/entitlements.plist | 11 ++++
 userland/uicache/install.py         | 63 ++++++++++++++++++++++
 userland/uicache/vince-uicache.m    | 81 +++++++++++++++++++++++++++++
 4 files changed, 182 insertions(+)
 create mode 100644 .github/workflows/uicache.yml
 create mode 100644 userland/uicache/entitlements.plist
 create mode 100755 userland/uicache/install.py
 create mode 100644 userland/uicache/vince-uicache.m

diff --git a/.github/workflows/uicache.yml b/.github/workflows/uicache.yml
new file mode 100644
index 0000000..40ef540
--- /dev/null
+++ b/.github/workflows/uicache.yml
@@ -0,0 +1,27 @@
+name: uicache
+# Builds vince-uicache (registers /Applications with LaunchServices) for the iOS 16 userland.
+# Run by hand (Actions -> uicache -> Run workflow). The result is the artifact "vince-uicache".
+on:
+  workflow_dispatch:
+
+jobs:
+  build:
+    runs-on: macos-15
+    timeout-minutes: 20
+    steps:
+      - uses: actions/checkout@v4
+      - name: Build
+        run: |
+          mkdir out
+          SDK=$(xcrun --sdk iphoneos --show-sdk-path)
+          xcrun clang -target arm64-apple-ios16.0 -isysroot "$SDK" -fobjc-arc -O1 -Wall \
+            -framework Foundation -o out/vince-uicache userland/uicache/vince-uicache.m
+          codesign -f -s - --entitlements userland/uicache/entitlements.plist out/vince-uicache
+          codesign -d --entitlements - out/vince-uicache || true
+          cp userland/uicache/install.py out/
+          ls -l out
+      - name: Result
+        uses: actions/upload-artifact@v4
+        with:
+          name: vince-uicache
+          path: out/
